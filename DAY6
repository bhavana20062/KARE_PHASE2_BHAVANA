import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc= new Scanner(System.in);
	    int n = sc.nextInt();
	    int  temp=n,d,sum=0;
	    while(n!=0){
	        d=n%10;
	        sum=sum+(d*d*d);
	        n=n/10;
	    }
	    if(sum==temp){
	        System.out.println("amstrong");
	    }else{
	        System.out.println(" not amstrong");
	        
	    }   
	}
}



import java.util.*;
class Main
{
	public static void main(String[] args) {
	    Scanner sc= new Scanner(System.in);
	    int n1 = sc.nextInt();
	    int n2 =sc.nextInt();
	    int s1=0,s2=0;
	    for(int i=1;i<=n1/2;i++){
	        if(n1%i==0)
	            s1=s1+i;
	        }
	        for(int i=1;i<=n2/2;i++){
	        if(n2%i==0)
	            s2=s2+i;
	        }
	        if(s1==n2 && s2==n1)
	            System.out.print("amicable");
	        else
	            System.out.print("not amicable");
	  }
}

